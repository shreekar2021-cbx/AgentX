APP_ENV=development
DEMO_MODE=true
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
APP_MAX_UPLOAD_MB=10
APP_RATE_LIMIT_PER_MINUTE=60
# Optional until Supabase is configured. Use the public anon key, never a service-role key.
SUPABASE_URL=
SUPABASE_ANON_KEY=
MISTRAL_API_KEY=
MISTRAL_MODEL_GENERAL=mistral-medium-latest
MISTRAL_MODEL_FAST=ministral-8b-latest
MISTRAL_MODEL_VISION=mistral-small-latest
MISTRAL_TIMEOUT_SECONDS=25
MISTRAL_MAX_RETRIES=2
WEATHER_TIMEOUT_SECONDS=8
WEATHER_CACHE_MINUTES=30
NEARBY_RADIUS_KM=10
LOCAL_DATABASE_PATH=.data/agrivision.sqlite3
APP_SEED_DEMO_DATA=true
ANALYSIS_RATE_LIMIT_PER_HOUR=12
OGD_API_KEY=
OGD_MARKET_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
MARKET_CACHE_MINUTES=60
MARKET_TIMEOUT_SECONDS=10
MARKET_TREND_RATE_LIMIT_PER_HOUR=20
