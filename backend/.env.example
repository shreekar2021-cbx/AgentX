APP_NAME=AgriVision AI API
APP_ENV=local
APP_MODE=live
AGRIVISION_DEBUG=false
CORS_ORIGINS=http://localhost:5173

# Leave all three blank for local startup without Supabase.
# Configure all three together after applying the migration.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
HTTP_TIMEOUT_SECONDS=10

# Crop health analysis; choose a supported Gemini model for your project.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=15

# Both are required for live AGMARKNET prices through data.gov.in.
DATA_GOV_API_KEY=
DATA_GOV_RESOURCE_ID=
# Optional; defaults to backend/data/market_prices.csv.
# MARKET_CSV_PATH=

# Optional FCM project. Firebase Admin uses Application Default Credentials;
# set GOOGLE_APPLICATION_CREDENTIALS to a service account JSON file when needed.
FIREBASE_PROJECT_ID=

DEFAULT_LANGUAGE=en
ALERT_RADIUS_KM=10
OUTBREAK_RISK_THRESHOLD=0.6
